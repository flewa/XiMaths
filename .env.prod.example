# Production (copier dans .env.prod, à côté de docker-compose.prod.yml).
# Ne jamais versionner .env.prod : il contient les secrets.

# Domaine public, servi en HTTPS par le proxy placé devant le front.
SITE_DOMAIN=ximaths.example

POSTGRES_DB=ximaths
POSTGRES_USER=ximaths
POSTGRES_PASSWORD=change-me

# Clé longue et aléatoire, par exemple : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# HSTS : à activer une fois le HTTPS en place (un an).
DJANGO_HSTS_SECONDS=31536000

# Emails : relais SMTP de Brevo.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=XiMaths <no-reply@ximaths.example>

# Connexion avec Google (facultative). Adresse de retour à déclarer chez Google :
# https://<SITE_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Embeddings (facultatifs, --profile embeddings) : http://embeddings
EMBEDDINGS_URL=

# Claude (facultatif) : résumés canoniques, avis sur les doublons, questions de compréhension.
ANTHROPIC_API_KEY=

# Suivi des erreurs (facultatif).
SENTRY_DSN=
