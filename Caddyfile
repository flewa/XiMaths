# Proxy HTTPS de production : certificat automatique pour {$SITE_DOMAIN}.
# L'API, l'admin des modérateurs et ses fichiers statiques vont à Django ; le reste au front.
# Une même origine pour tout : le cookie de session et le jeton CSRF marchent sans CORS.
{$SITE_DOMAIN} {
	encode zstd gzip

	# En-têtes de sécurité pour tout le site. Les pages du front n'en envoient pas d'elles-mêmes ;
	# « ? » laisse intacts ceux que Django met déjà sur l'API. HSTS reprend DJANGO_HSTS_SECONDS
	# de .env.prod (0 : désactivé).
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy same-origin
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		?Strict-Transport-Security "max-age={$HSTS_SECONDS:0}; includeSubDomains"
		-Server
		-X-Powered-By
	}

	@django path /api/* /admin /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000
	}

	# Mesure d'audience : le script d'Umami et l'envoi des visites passent par le site même,
	# rien d'autre (son tableau de bord est sur stats., plus bas).
	@mesure path /mesure/script.js /mesure/api/send
	handle @mesure {
		uri strip_prefix /mesure
		reverse_proxy umami:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# www.{$SITE_DOMAIN} renvoie vers l'adresse sans www : une seule adresse par page pour les
# moteurs de recherche. Il faut un enregistrement DNS pour www (A ou CNAME vers le serveur) ;
# sans lui, Caddy ne peut pas obtenir le certificat de www et le signale dans ses journaux.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Tableau de bord de la mesure d'audience (Umami), réservé à son compte admin : voir
# deploy/statistiques.sh. Il faut un enregistrement DNS pour stats, comme pour www.
stats.{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy same-origin
		?Strict-Transport-Security "max-age={$HSTS_SECONDS:0}; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}
	reverse_proxy umami:3000
}
