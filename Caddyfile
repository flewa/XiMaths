# Proxy HTTPS de production : certificat automatique pour {$SITE_DOMAIN}.
# L'API, l'admin des modérateurs et ses fichiers statiques vont à Django ; le reste au front.
# Une même origine pour tout : le cookie de session et le jeton CSRF marchent sans CORS.
{$SITE_DOMAIN} {
	encode zstd gzip

	# En-têtes de sécurité pour tout le site. Les pages du front n'en envoient pas d'elles-mêmes ;
	# « ? » laisse intacts ceux que Django met déjà sur l'API. HSTS reprend DJANGO_HSTS_SECONDS
	# de .env.prod (0 : désactivé).
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy same-origin
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		?Strict-Transport-Security "max-age={$HSTS_SECONDS:0}; includeSubDomains"
		-Server
		-X-Powered-By
	}

	@django path /api/* /admin /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
