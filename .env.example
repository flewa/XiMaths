# Backend (copier dans backend/.env)
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sans DATABASE_URL, le backend utilise SQLite (backend/db.sqlite3).
DATABASE_URL=postgres://ximaths:ximaths@localhost:5432/ximaths
REDIS_URL=redis://localhost:6379/0
# Adresse du front, utilisée dans les liens envoyés par email.
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Proxys de confiance devant l'API (le front Next.js), pour la limitation de débit.
NINJA_NUM_PROXIES=1
# En développement, les emails s'affichent dans la console du backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Service d'embeddings bge-m3 (docker compose). Sans lui, la détection de doublons
# n'utilise que les signatures MinHash : quasi-copies et variantes paramétriques.
EMBEDDINGS_URL=http://localhost:8080

# Front (copier dans frontend/.env.local)
# 127.0.0.1 et non localhost : Node résout localhost en IPv6, où runserver n'écoute pas.
API_URL=http://127.0.0.1:8000
