# Backend (copier dans backend/.env)
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sans DATABASE_URL, le backend utilise SQLite (backend/db.sqlite3).
DATABASE_URL=postgres://ximaths:ximaths@localhost:5432/ximaths
REDIS_URL=redis://localhost:6379/0
# Adresse du front, utilisée dans les liens envoyés par email.
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Proxys de confiance devant l'API (le front Next.js), pour la limitation de débit.
NINJA_NUM_PROXIES=1
# En développement, les emails s'affichent dans la console du backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Envoi réel par le relais SMTP de Brevo :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=XiMaths <no-reply@ximaths.test>
# Service d'embeddings bge-m3 (docker compose). Sans lui, la détection de doublons
# n'utilise que les signatures MinHash : quasi-copies et variantes paramétriques.
EMBEDDINGS_URL=http://localhost:8080
# Connexion avec Google (facultative). Adresse de retour à déclarer chez Google :
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domaines d'établissements reconnus pour le badge « Étudiant vérifié », en plus de la
# liste de backend/accounts/academic.py, séparés par des virgules.
ACADEMIC_EXTRA_DOMAINS=
# Claude (facultatif) : résumés canoniques des énoncés, avis sur les doublons,
# questions de compréhension. Vide : rien n'est appelé.
ANTHROPIC_API_KEY=
LLM_TIMEOUT=60

# Front (copier dans frontend/.env.local)
# 127.0.0.1 et non localhost : Node résout localhost en IPv6, où runserver n'écoute pas.
API_URL=http://127.0.0.1:8000
# Adresse publique du site : plan du site, robots.txt et balises OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
